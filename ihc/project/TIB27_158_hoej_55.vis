         <functionblock id="_0x21d528" name="4.1.13. Powerup - Always on" master_schneider_electric="yes" master_type="4.1.13" master_name="Powerup - Always on" master_programmer="Claus Jørgensen &#xD;&#xA;Lauritz Knudsen  &#xD;&#xA;Schneider Electric Danmark A/S" master_date_year="2012" master_date_month="2" master_date_day="14" locked="yes" icon="_0xe" note="4.1.13. Powerup - Puls - Always on&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Når controller opstart eller genstarter, giver Udgangen &quot;One Shot&quot; samt en kort puls (250ms)&#xD;&#xA;Samtidig vil udgangen &quot;Always On&quot; få værdien &quot;ON&quot; og forblive &quot;ON&quot; &#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x21d623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken"/>
            <outputs id="_0x21d724" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x21d812" name="One Shot" icon="_0x39"/>
               <resource_output id="_0x21d912" name="Always On" icon="_0x39"/>
            </outputs>
            <settings id="_0x21da25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken"/>
            <internalsettings id="_0x21db29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x21dc10" name="Puls Timer" icon="_0x43" hour="0" minute="0" second="0" millisecond="250"/>
            </internalsettings>
            <programs id="_0x21dd26" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x21de1e" name="Program" icon="_0x7">
                  <events id="_0x21df64" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event_power id="_0x21e0c8" name="Powerup" icon="_0xc" note="Start program ved Powerup"/>
                  </events>
                  <actions id="_0x21e166" name="Kommandoer" icon="_0x8" note="Gruppering af kommandoer som udføres når hændelse er indtruffet" type="_0x2">
                     <action id="_0x21e2ca" name="%P = ON" icon="_0x9" note="Sætter %P til ON" link1="_0x21d812" method="_0xa"/>
                     <action id="_0x21e3ca" name="%P = ON" icon="_0x9" note="Sætter %P til ON" link1="_0x21d912" method="_0xa"/>
