         <functionblock id="_0x15a628" name="Timer med Dag,Nat og Skumring - TIB27" master_name="Timer med Dag,Nat og Skumring - TIB27" master_programmer="jan" master_date_year="2020" master_date_month="5" master_date_day="23" locked="yes" icon="_0x10" note="2.1.01.a. 7 dages ur, med 1 tænd tidspunkt&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;7 dages ur, hvor der kun er et tænd- og sluktidspunkt. Dvs. at alle ugens 7 dage har samme tænd- og sluktidspunkt.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x15a723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x15a811" name="Tryk (manuel overstyring)" icon="_0x36" note="Manuelt overstyring af ur - En aktivering vil skifte udgangen. Udgang for ur vil forblive i tilstanden indtil næste urtidspunkt.&#xD;&#xA;(Udfyldes af installatøren)"/>
            </inputs>
            <outputs id="_0x15a924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x15aa12" name="Udgang fra ur" icon="_0x39" note="Anvendes til urstyring"/>
               <resource_output id="_0x15ab12" name="ON puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for ur&quot; går on&#xD;&#xA;Anvedes til styring af andre blokke."/>
               <resource_output id="_0x15ac12" name="OFF puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for ur&quot; går off&#xD;&#xA;Anvedes til styring af andre blokke."/>
               <resource_scene id="_0x15ad4a" name="Scenarie Dag" note="Fremkalder scenarie når &quot;Udgang for ur&quot; går on&#xD;&#xA;Anvedes til styring af andre blokke."/>
