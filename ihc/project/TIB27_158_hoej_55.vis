         <functionblock id="_0x2ee428" name="1.2.05. Trådløs lysdæmperstyring med PIR" master_schneider_electric="yes" master_type="1.2.05" master_name="Trådløs lysdæmperstyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="5" master_date_day="12" locked="yes" icon="_0xe" note="1.2.05. Trådløs lysdæmperstyring&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af IHC Wireless lysdæmper ifm. PIR og IHCRemote og IHCTablet app.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering.&#xD;&#xA;Kan fremkalde/gemme to scenarier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x2f0123" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2f0211" name="Touch " icon="_0x36" note="Kort tryk tænd/sluk - langt tryk regulerer lys niveau op/ned.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x2f0311" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x2f0411" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x2f0511" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x2f0611" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_light_level id="_0x2f0713" name="Lys niveau " note="Opret link mellem produktets &quot;Lys niveau&quot; og denne indgang.&#xD;&#xA;Funktionsblokken virker ikke korrekt uden denne sammenhæng.&#xD;&#xA;"/>
               <resource_input id="_0x2f0811" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x2f0911" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstilling &quot;# PIR funktion&quot; og &quot;# PIR funktion nat&quot;.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x2f0a11" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" inivalue="on"/>
               <resource_input id="_0x2f0b11" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
            </inputs>
            <outputs id="_0x2f0c24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x2f0d4a" name="Højt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;Default 100%, rampetid 1 sek." hide_dialog="yes"/>
               <resource_scene id="_0x2f0e4a" name="Lavt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;"/>
               <resource_scene id="_0x2f0f4a" name="Sluk" note="Forbindes til lysdæmperen med 0% lysniveau og den ønskede rampetid.&#xD;&#xA;Ved automatisk sluk benyttes den valgte rampetid og ved manuel sluk benyttes default tiden i lysdæmperen (700ms) for &quot;softsluk&quot;.&#xD;&#xA;"/>
               <resource_enum id="_0x2f100f" name="Lysdæmper status" typedef="_0x2eec47" inivalue="_0x2eee48" backup="yes" icon="_0x22" note="Status indikering til Viewer."/>
               <resource_timer id="_0x2f1110" name="Efterløb udløber om" icon="_0x43" note="Bemærk:&#xD;&#xA;Hvis efterløb viser 00:00:00,000 er efterløb deaktiveret.&#xD;&#xA;" hour="0" minute="0" second="0" millisecond="0"/>
               <resource_output id="_0x2f1212" name="Manuelt betjent " backup="yes" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR."/>
               <resource_output id="_0x2f1312" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer."/>
            </outputs>
            <settings id="_0x2f1425" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x2f150f" name="Kort reguleringstryk tænder" typedef="_0x2ee847" inivalue="_0x2ee948" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
               <resource_enum id="_0x2f160f" name="Manuel betjening" typedef="_0x2efd47" inivalue="_0x2eff48" backup="yes" icon="_0x22" note="Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb dag/aften efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Starter ekstra efterløb til sluk&quot; vil lys slukke på ekstra efterløb til sluk efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv."/>
               <resource_enum id="_0x2f170f" name="PIR funktion " typedef="_0x2ef647" inivalue="_0x2ef748" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Trin høj/sluk&#xD;&#xA;Trin høj/lav&#xD;&#xA;Trin høj/lav/sluk&#xD;&#xA;Trin høj/lav/+ekstra efterløb til sluk&#xD;&#xA;Trin lav/sluk&#xD;&#xA;Dag/aften slukkes kun lys"/>
               <resource_enum id="_0x2f180f" name="PIR funktion nat" typedef="_0x2ee547" inivalue="_0x2ee648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Trin lav/sluk&quot; kan benyttes til alle rum - dog ikke soverum.&#xD;&#xA;&quot;Kun efterløb&quot; benyttes til soverum og andre rum der ønskes undtaget."/>
               <resource_timertime id="_0x2f1917" name="Efterløb dag/aften" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for dag/aften." hour="0" minute="3" second="0" millisecond="0"/>
               <resource_timertime id="_0x2f1a17" name="Efterløb nat" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for natdrift." hour="0" minute="1" second="0" millisecond="0"/>
               <resource_timertime id="_0x2f1b17" name="Ekstra efterløb til sluk " backup="yes" icon="_0x4d" note="Her indstilles ekstra efterløbstid.&#xD;&#xA;Benyttes ifm. disse valg:&#xD;&#xA;&quot;PIR funktion = Trin høj/lav/+ekstra efterløb til sluk&quot; &#xD;&#xA;&quot;Manuel betjening = Aktivt ekstra efterløb til sluk&quot;&#xD;&#xA;Efter sidste påvirking af PIR, tryk eller app regulering vil lys afhængig af opsætning slukke med den valgte initial værdi." hour="2" minute="0" second="0" millisecond="0"/>
            </settings>
            <internalsettings id="_0x2f1c29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x2f1d10" name="Spærring af PIR efter manuel sluk " icon="_0x43" hour="0" minute="0" second="15" millisecond="0"/>
               <resource_timer id="_0x2f1e10" name="Gem nyt scenarie efter " icon="_0x43" hour="0" minute="0" second="3" millisecond="0"/>
               <resource_timer id="_0x2f1f10" name="Kvittér med blink af scenarie" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
               <resource_timer id="_0x2f2010" name="Kvittér med blink efter manuel sluk" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
