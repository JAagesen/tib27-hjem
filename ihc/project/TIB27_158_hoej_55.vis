         <functionblock id="_0x256728" name="Dimmer med PIR Styringsinput og Single og multi Touch Regulering og Multi UR scenarier" master_name="Dimmer med PIR Styringsinput og Single og multi Touch Regulering og Multi UR scenarier" master_programmer="Alex" master_date_year="2018" master_date_month="8" master_date_day="26" locked="yes" icon="_0x10" note="Designed til at arbejde sammen med funktionsblok som registrerer PIR og tænder og slukker lyset på tid. PIR Styring indgang er udgang fra PIR styring funktionsblokken til tænd/sluk af lys, indgangen kan ikke kobles direkte til PIR udgang. &#xD;&#xA;&#xD;&#xA;3 Ure, og 4 scenarier. Nar lyset taendes bruges scenariet for det første aktive ur, og scenarie 4 hvis alle inaktive.&#xD;&#xA;&#xD;&#xA;Touch Indgang: &#xD;&#xA;Tryk på touch dimmer lyset&#xD;&#xA;Kort tryk på Touch kipper lyset (ved sluk anvendes feature i Wireless dimmer som at kort tryk på dim-ned bliver til sluk). Længere, langt tryk regulerer lyset op/ned.&#xD;&#xA;&#xD;&#xA;Reguler Op/Ned taster: Disse slukke ikke lyset men tænder hvis det er slukket.&#xD;&#xA;&#xD;&#xA;Sluk alt: Benyt PIR styrings indang i stedet til sluk, da PIR timeres så nulstilles korrekt.&#xD;&#xA;&#xD;&#xA;Bemaerk:&#xD;&#xA;Sender signal tilbage til PIR kontroller funktionsblok om udgang on (via touch/reguler taster) via &apos;PIR Styring&apos; indgang. Dette betyder PIR kontroller block kan starte dens Forced light.&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;">
            <inputs id="_0x256b23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x256c11" name="PIR Styring " icon="_0x36" note="Lys-Udgang fra PIR blok. Lys On/Off følger denne indgang, dvs. lys slukkes når denne indgang slukkes."/>
               <resource_input id="_0x256d11" name="Touch" icon="_0x36" note="Kort tryk tænder/slukker lyset.&#xD;&#xA;Langt tryk regulerer lyset op/ned.&#xD;&#xA;Regulation starter med det samme og Wireless Dimmer indgang konvertere til sluk når det blev til kort tryk"/>
               <resource_input id="_0x256e11" name="Reguler op" icon="_0x36"/>
               <resource_input id="_0x256f11" name="Reguler ned" icon="_0x36" note="Regulerer ned, slukker aldrig, fordi der sendes altid mindst en puls længde som sørger for at Dimmer ikke slukker lyset"/>
               <resource_input id="_0x257011" name="Sluk lyset" icon="_0x36" note="Slukker lyset og resetter en evt spærring"/>
               <resource_input id="_0x257111" name="LysIndekering tilbagemelding" icon="_0x36" note="Skal forbindes til lysindikering fra lysdæmper" note-2="Værdien rettes når denne blok tænder/slukker lyset fordi det gjorde IHC Dimmer funktionsblok, og måske er det for at sikre at vi kan stole på værdien med det samme vi har ændret tilstand på sceniare.&#xD;&#xA;"/>
               <resource_input id="_0x257211" name="UR1" icon="_0x36" note="Hvis indgangen er On tænder PIR lyset på niveau 1&#xD;&#xA;ved Off tændes på niveau 2"/>
               <resource_input id="_0x257311" name="UR2" icon="_0x36"/>
               <resource_input id="_0x257411" name="UR3" icon="_0x36"/>
            </inputs>
            <outputs id="_0x257524" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x25764a" name="Scenarie for UR1"/>
               <resource_scene id="_0x25774a" name="Scenarie for UR2  (UR 1 off)"/>
               <resource_scene id="_0x25784a" name="Scenarie for UR3 (UR 1-2 off)"/>
               <resource_scene id="_0x25794a" name="Scenarie for Ur 1-3 Off"/>
            </outputs>
            <settings id="_0x257a25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x257b10" name="DimNedMinimumPulsTimer" icon="_0x43" note="Reguler ned slukker lyset hvis puls er under ca 600 ms paa Wireless Uni Dimmer (Kobt ca 2015, sw ver 1.05a). Derfor denne minimums puls timer" hour="0" minute="0" second="0" millisecond="600"/>
               <resource_timer id="_0x257c10" name="Bevar sidste lysstyrke Timer" icon="_0x43" hour="0" minute="5" second="0" millisecond="0"/>
               <resource_flag id="_0x257d0a" name="isManueltReguleret" icon="_0x33"/>
               <resource_integer id="_0x257e0b" name="SidsteUr"/>
            </settings>
            <internalsettings id="_0x257f29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_enum id="_0x25800f" name="Sidste retning" typedef="_0x256847" inivalue="_0x256a48" icon="_0x22"/>
               <resource_flag id="_0x25810a" name="LightOn" icon="_0x33"/>
               <resource_flag id="_0x25820a" name="doSluk" icon="_0x33"/>
               <resource_flag id="_0x25830a" name="doRegulerOp" icon="_0x33"/>
               <resource_flag id="_0x25840a" name="doRegulerNed" icon="_0x33"/>
               <resource_flag id="_0x25850a" name="doRegulerStop" icon="_0x33"/>
               <resource_timer id="_0x258610" name="KortTouchTimerTilSluk" icon="_0x43" hour="0" minute="0" second="0" millisecond="400"/>
               <resource_flag id="_0x25870a" name="doLightOn" icon="_0x33"/>
            </internalsettings>
            <programs id="_0x258826" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x25891e" name="Touch ON" icon="_0x7" note="Kort touch ned bliver konverteret i wireless dimmer til OFF. &#xD;&#xA;">
                  <events id="_0x258a64" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x258bc8" name="%P -&gt; ON" icon="_0xc" note="Start program når %P skifter til ON" link1="_0x256d11" method="_0xa"/>
                  </events>
