         <functionblock id="_0x273028" name="Special blok til Bjarne Sørensen" master_name="Special blok til Bjarne Sørensen" master_programmer="Henning" master_date_year="2016" master_date_month="4" master_date_day="12" locked="yes" icon="_0x10" note="Kort tryk på Touch kipper lyset, langt tryk regulerer lyset op/ned,  hvis lyset tændes spærres PIR&#xD;&#xA;PIR tænder på 2 niveauer afhængigt af indgang UR, men kun hvis det er mørkt.&#xD;&#xA;Lyset kan slukkes via ?Sluk alt?, ?Godnat? osv.&#xD;&#xA;Blokken kan indstilles til om spærringen af PIR skal afstilles automatisk og efter hvor lang tid.">
            <inputs id="_0x273723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x273811" name="Touch" icon="_0x36" note="Kort tryk tænder/slukker lyset, hvis lyset tændes spærres PIR&#xD;&#xA;Langt tryk regulerer lyset op/ned"/>
               <resource_input id="_0x273911" name="Skumring" icon="_0x36"/>
               <resource_input id="_0x273a11" name="PIR" icon="_0x36" note="Tænder lyset på to forskellige niveauer alt efter om indgang for UR er On eller Off"/>
               <resource_input id="_0x273b11" name="UR" icon="_0x36" note="Hvis indgangen er On tænder PIR lyset på niveau 1&#xD;&#xA;ved Off tændes på niveau 2"/>
               <resource_input id="_0x273c11" name="Sluk lyset" icon="_0x36" note="Slukker lyset og resetter en evt spærring"/>
               <resource_input id="_0x273d11" name="Tilbagemelding" icon="_0x36" note="Skal forbindes til lysindikering fra lysdæmper"/>
            </inputs>
            <outputs id="_0x273e24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x273f4a" name="PIR Scenarie med ur = On"/>
               <resource_scene id="_0x27404a" name="PIR Scenarie med ur = Off"/>
               <resource_scene id="_0x27414a" name="Scenarie ved manuel tænding"/>
               <resource_output id="_0x274212" name="Manuelt betjent" icon="_0x39"/>
            </outputs>
