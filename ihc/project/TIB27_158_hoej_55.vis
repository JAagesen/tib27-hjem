         <functionblock id="_0x7a6c28" name="1.4.02.a. PIR styring af Håndklædevarmer og lys i entré skab" master_name="PIR styring " master_programmer="jan" master_date_year="2023" master_date_month="8" master_date_day="11" icon="_0xf" note="1.4.02.a. PIR styring &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til simpel styring af IHC Wireless produkter og relæer ifm. PIR og manuel betjening.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x7a7623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x7a7711" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstillinger:&#xD;&#xA; &quot;# PIR funktion&quot;&#xD;&#xA; &quot;# PIR funktion nat&quot;&#xD;&#xA;(Udfyldes af installatøren)">
                  <link_to_resource id="_0x7bb42c" name="Følg Link" icon="_0x4a" link="_0x7bb32d"/>
               </resource_input>
               <resource_input id="_0x7a7811" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;Alternativt via ur funktionsblok.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" inivalue="on"/>
               <resource_input id="_0x7a7911" name="Tilbagemelding" icon="_0x36" note="Opret link mellem produktets &quot;Udgang&quot; og &quot;Tilbagemelding&quot;.&#xD;&#xA;Ved tilbagemelding begrænses genkald af IHC Wireless produkter ifm. PIR aktivitet."/>
               <resource_input id="_0x7a7a11" name="Natdrift" icon="_0x36" note="Anvendes som begrænsning for PIR funktion om natten.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x7a7b11" name="Kip" icon="_0x36" note="Kipper udgang og scenarier&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x7a7c11" name="Tænd" icon="_0x36" note="Tænder udgang og scenarie &#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x7a7d11" name="Sluk" icon="_0x36" note="Slukker udgang og scenarie.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;">
                  <link_to_resource id="_0x81e22c" name="Følg Link" icon="_0x4a" link="_0x81e12d"/>
               </resource_input>
               <resource_input id="_0x7a7e11" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_enum id="_0x7d9b0f" name="UR BAD Aktiv" typedef="_0x7d8f47" inivalue="_0x7d9048" icon="_0x22">
                  <link_to_resource id="_0x7d9d2c" name="Følg Link" icon="_0x4a" link="_0x7d9c2d"/>
               </resource_enum>
            </inputs>
            <outputs id="_0x7a7f24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x7a8012" name="Udgang" icon="_0x39" note="Forbindes til relæ hvis scenariefunktion ikke benyttes.&#xD;&#xA;">
                  <link_from_resource id="_0x7bb12d" name="Følg Link" icon="_0x47" link="_0x7bb22c"/>
               </resource_output>
               <resource_output id="_0x7a8112" name="ON puls" icon="_0x39" note="Giver kort puls ved tænding.&#xD;&#xA;Anvendes til styring af andre blokke."/>
               <resource_output id="_0x7a8212" name="OFF puls" icon="_0x39" note="Giver kort puls ved slukning.&#xD;&#xA;Anvendes til styring af andre blokke."/>
               <resource_output id="_0x7a8312" name="Manuelt betjent" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR."/>
               <resource_scene id="_0x7a844a" name="Scenarie tænd" note="Forbindes til relæ og/eller IHC Wireless lysdæmper."/>
               <resource_scene id="_0x7a854a" name="Scenarie sluk" note="Forbindes til relæ og/eller IHC Wireless lysdæmper."/>
            </outputs>
            <settings id="_0x7a8625" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x7a8710" name="Efterløb" backup="yes" icon="_0x43" note="Her indstilles efterløbstiden.&#xD;&#xA;" hour="0" minute="0" second="0" millisecond="0"/>
               <resource_enum id="_0x7a880f" name="PIR funktion" typedef="_0x52e547" inivalue="_0x52e648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;"/>
               <resource_enum id="_0x7a890f" name="PIR funktion nat" typedef="_0x52e847" inivalue="_0x52ea48" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;"/>
               <resource_enum id="_0x7a8a0f" name="Manuel tænding" typedef="_0x52e247" inivalue="_0x52e348" icon="_0x22" note="Her er det muligt, at vælge funktion på manuel tænding.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb efter sidste påvirking af PIR eller tryk.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv."/>
            </settings>
            <internalsettings id="_0x7a8b29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x7a8c10" name="Blokkering efter manuel sluk" icon="_0x43" hour="0" minute="0" second="15" millisecond="0"/>
               <resource_timer id="_0x7a8d10" name="Puls" icon="_0x43" hour="0" minute="0" second="0" millisecond="250"/>
               <resource_timer id="_0x7a8e10" name="Kvittér med blink efter manuel sluk" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
            </internalsettings>
