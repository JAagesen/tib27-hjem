         <functionblock id="_0x267b28" name="PIR med skumring og alarm" master_name="PIR med skumring og alarm" master_programmer="Børn" master_date_year="2015" master_date_month="5" master_date_day="30" locked="yes" icon="_0x10" note="PIR lysstyring med indgang for skumringsrelæ og alarm status.&#xD;&#xA;&#xD;&#xA;Kan bruges med både Alarm PIR og alm. lys PIR.&#xD;&#xA;Skumringsrelæ kan fra/tilvælges&#xD;&#xA;Lys funktion under alarm kan fra/tilvælges.&#xD;&#xA;&#xD;&#xA;Udgange for:&#xD;&#xA;Tænd lys (puls)&#xD;&#xA;Sluk lys (puls)&#xD;&#xA;Tænd lys (konstant)&#xD;&#xA;App status&#xD;&#xA;Alarm (puls)">
            <inputs id="_0x268523" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x268611" name="PIR" icon="_0x36" note-2="Indgang fra PIR bevægelse"/>
               <resource_input id="_0x268711" name="Skumring" icon="_0x36" note-2="Indgang fra skumringsrelæ"/>
               <resource_input id="_0x268811" name="Alarm status" icon="_0x36" note-2="Indgang fra alarm status"/>
            </inputs>
            <outputs id="_0x268924" name="Udgange" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x268a12" name="Tænd lys (puls)" icon="_0x39" note-2="Udgang til at forbinde til f.eks. Tænd på kip styrring&#xD;&#xA;Bemærk: Pulser kun ved første gangs aktivering, aktiveringer mens timer for PIR kører vil ikke genere en puls."/>
               <resource_output id="_0x268b12" name="Sluk lys (puls)" icon="_0x39" note-2="Udgang til at forbinde til f.eks. Sluk på kip styrring"/>
               <resource_output id="_0x268c12" name="Tænd lys (konstant)" icon="_0x39" note-2="Høj så længe PIR timer kører, kan bruges som følg&#xD;&#xA;"/>
               <resource_output id="_0x268d12" name="App status (lys)" icon="_0x39" note-2="Spejl af &quot;Tænd lys (konstant)&quot;.&#xD;&#xA;Bruges til at man i App&apos;en kan se om PIR blokken har tændt lyset."/>
               <resource_output id="_0x268e12" name="Alarm (puls)" icon="_0x39" note-2="Pulser ved bevægelse når alarmen er slået til"/>
            </outputs>
            <settings id="_0x268f25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x269010" name="Pir Timer" icon="_0x43" hour="0" minute="0" second="20" millisecond="0" note-2="Tid lyset skal være tændt efter sidste bevægelse"/>
               <resource_enum id="_0x26910f" name="PIR type" typedef="_0x268247" inivalue="_0x268348" icon="_0x22" note-2="Type af PIR sensor:&#xD;&#xA;Alarm: Sensoren er ON ved ingen bevægelse og OFF ved bevægelse&#xD;&#xA;Lys: Sensoren er OFF ved ingen bevægelse og ON ved bevægelse"/>
               <resource_enum id="_0x26920f" name="Benyt skumring" typedef="_0x267f47" inivalue="_0x268148" icon="_0x22" note-2="Aktivering af skumringsrelæ.&#xD;&#xA;Ja: Lys virker kun når skumring er ON&#xD;&#xA;Nej: Lys virker altid&#xD;&#xA;Alarm udgang er ikke påvirket af skumring"/>
               <resource_enum id="_0x26930f" name="Alarm status" typedef="_0x267c47" inivalue="_0x267e48" icon="_0x22" note-2="Vælg om lysets udgange skal pulse selvom alarmen er slået til.&#xD;&#xA;Lysets udgange vil stadig være afhængige af indstillingen for skumring."/>
               <resource_timertime id="_0x269417" name="Puls tid" icon="_0x4d" hour="0" minute="0" second="0" millisecond="500" note-2="Hvor lang pulsen er på puls udgange."/>
            </settings>
            <internalsettings id="_0x269529" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_flag id="_0x26960a" name="Pir signal" icon="_0x33" note-2="PIR signalet konverteret.&#xD;&#xA;ON = bevægelse uanset PIR type."/>
               <resource_timer id="_0x269710" name="Puls Off" icon="_0x43" hour="0" minute="0" second="0" millisecond="0" note-2="Timer for sluk udgang&#xD;&#xA;"/>
               <resource_timer id="_0x269810" name="Puls tænd" icon="_0x43" hour="0" minute="0" second="0" millisecond="0" note-2="Timer for Tænd udgang"/>
               <resource_timer id="_0x269910" name="Alarm puls" icon="_0x43" hour="0" minute="0" second="0" millisecond="0" note-2="Timer for alarm udgang"/>
               <resource_flag id="_0x269a0a" name="Lys tilladt" icon="_0x33" note-2="Lys er tilladt for skumringsrelæ og Alarm indstilling"/>
               <resource_flag id="_0x269b0a" name="Alarm tillader lys" icon="_0x33" note-2="Alarm indstillingen tillader lys udgangene at blive aktiveret.&#xD;&#xA;Påvirker Lys tilladt."/>
            </internalsettings>
