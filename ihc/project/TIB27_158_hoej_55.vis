         <functionblock id="_0x84a628" name="Billedlys over pigen følger spisekarnappen" master_name="Billedlys over pigen følger spisekarnappen" master_programmer="Jan Bjerre Aagesen" master_date_year="2026" master_date_month="10" master_date_day="18" icon="_0xf" note="Tilføjet 2026-10-18.&#xD;&#xA;&#xD;&#xA;Tændes lyset i spisekarnappen på tasten, tændes billedlyset over pigen med - dog kun når det er mørkt udenfor. Slukkes spisekarnappen igen, slukkes billedlyset KUN hvis ingen af de fire andre stuelamper er tændt - ellers bliver det stående og slukkes som normalt sammen med resten af stuen.&#xD;&#xA;&#xD;&#xA;Blokken følger spisekarnappens tast, ikke dens lamper, og rører derfor ikke TV- og Nat-scenariet, hvor billedlyset er dæmpet med vilje.">
            <inputs id="_0x84a723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_enum id="_0x84a80f" name="Status Lys i Spisekarnap" typedef="_0x7a4647" inivalue="_0x7a4848" icon="_0x22" note="Fra spisekarnappens trådløse dæmper. Sættes kun af tasterne - ikke af scenarier.">
                  <link_to_resource id="_0x84a92c" name="Følg Link" icon="_0x4a" link="_0x84aa2d"/>
               </resource_enum>
               <resource_enum id="_0x84ab0f" name="Status Lys i Stue" typedef="_0x3b2d47" inivalue="_0x3b3248" icon="_0x22" note="Fra Scenarie funktion Stor Stue. Kører TV eller Nat, er billedlyset dæmpet med vilje, og blokken holder fingrene fra det.">
                  <link_to_resource id="_0x84ac2c" name="Følg Link" icon="_0x4a" link="_0x84ad2d"/>
               </resource_enum>
               <resource_input id="_0x84dc11" name="Skumring" icon="_0x36" note="Skumringsrelæet &quot;Udenfor det frostfri&quot; - samme signal som gangen og køkkenet bruger. ON når det er mørkt udenfor.">
                  <link_to_resource id="_0x84dd2c" name="Følg Link" icon="_0x4a" link="_0x84de2d"/>
               </resource_input>
               <resource_input id="_0x84ae11" name="Lys: Røde lamper" icon="_0x36" note="Lys indikering fra de røde lamper over sofaen">
                  <link_to_resource id="_0x84af2c" name="Følg Link" icon="_0x4a" link="_0x84b02d"/>
               </resource_input>
               <resource_input id="_0x84b111" name="Lys: Standerlampe" icon="_0x36" note="Lys indikering fra standerlampen">
                  <link_to_resource id="_0x84b22c" name="Følg Link" icon="_0x4a" link="_0x84b32d"/>
               </resource_input>
               <resource_input id="_0x84b411" name="Lys: Pladespiller" icon="_0x36" note="Lys indikering fra lampen ved pladespilleren">
                  <link_to_resource id="_0x84b52c" name="Følg Link" icon="_0x4a" link="_0x84b62d"/>
               </resource_input>
               <resource_input id="_0x84b711" name="Lys: Klaver" icon="_0x36" note="Lys indikering fra billedbelysningen over klaveret">
                  <link_to_resource id="_0x84b82c" name="Følg Link" icon="_0x4a" link="_0x84b92d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x84ba24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x84bb4a" name="Tænd billedlys over pigen" note="Tænder billedlyset over pigen på 45 % - samme niveau som Dag-scenariet - over 2 sekunder. Niveau og rampetid ændres frit her." icon="_0x47" hide_dialog="yes">
                  <scene_link id="_0x84bc4b" name="Scenarie link" icon="_0x47" link="_0x84bd4c"/>
               </resource_scene>
               <resource_scene id="_0x84be4a" name="Sluk billedlys over pigen" note="Slukker billedlyset over pigen over 3 sekunder." icon="_0x47" hide_dialog="yes">
                  <scene_link id="_0x84bf4b" name="Scenarie link" icon="_0x47" link="_0x84c04c"/>
               </resource_scene>
            </outputs>
            <programs id="_0x84c126" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x84c21e" name="Spisekarnappen tændes eller slukkes" icon="_0x7" note="Kører hver gang spisekarnappens status skifter på tasten.">
                  <events id="_0x84c364" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x84c4c8" name="%P skifter tilstand" icon="_0xc" note="Start program når %P skifter tilstand" link1="_0x84a80f" method="_0x96"/>
                  </events>
                  <actions id="_0x84c566" name="Kommandoer" icon="_0x8" note="Kommandoer" type="_0x2">
                     <program_sub id="_0x84c61f" name="Spisekarnappen er tændt" icon="_0x7">
                        <conditions id="_0x84c765" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                           <condition id="_0x84c8c9" name="%P = %S" icon="_0x1a" note="Spisekarnappen er lige tændt" link1="_0x84a80f" link2="_0x84c90f" method="_0x1e">
                              <resource_enum id="_0x84c90f" name="Enumerator" typedef="_0x7a4647" inivalue="_0x7a4748" icon="_0x22"/>
                           </condition>
                        </conditions>
                        <actions id="_0x84ca66" name="Tænd billedlyset med" icon="_0x8" type="_0x1">
                           <program_sub id="_0x84cb1f" name="Mørkt ude, og stuen kører ikke et scenarie" icon="_0x7" note="Billedlyset tændes kun når skumringsrelæet melder mørkt. Under TV, Nat og Fuldt lys sætter stue-scenariet selv billedlysets niveau, og der røres det ikke.">
                              <conditions id="_0x84cc65" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                                 <condition id="_0x84dfc9" name="%P = ON" icon="_0x1a" note="Det er mørkt udenfor" link1="_0x84dc11" method="_0xa"/>
                                 <condition id="_0x84cdc9" name="%P &lt;&gt; %S" icon="_0x1a" note="Stuen kører ikke TV" link1="_0x84ab0f" link2="_0x84ce0f" method="_0x28">
                                    <resource_enum id="_0x84ce0f" name="Enumerator" typedef="_0x3b2d47" inivalue="_0x3b2e48" icon="_0x22"/>
                                 </condition>
                                 <condition id="_0x84cfc9" name="%P &lt;&gt; %S" icon="_0x1a" note="Stuen kører ikke Nat" link1="_0x84ab0f" link2="_0x84d00f" method="_0x28">
                                    <resource_enum id="_0x84d00f" name="Enumerator" typedef="_0x3b2d47" inivalue="_0x3b3148" icon="_0x22"/>
                                 </condition>
                                 <condition id="_0x84e2c9" name="%P &lt;&gt; %S" icon="_0x1a" note="Stuen kører ikke Fuldt lys" link1="_0x84ab0f" link2="_0x84e30f" method="_0x28">
                                    <resource_enum id="_0x84e30f" name="Enumerator" typedef="_0x3b2d47" inivalue="_0x3b2f48" icon="_0x22"/>
                                 </condition>
                              </conditions>
                              <actions id="_0x84d166" name="Tænd billedlyset" icon="_0x8" type="_0x1">
                                 <action id="_0x84d2ca" name="Fremkald %P" icon="_0x9" note="Tænder billedlyset over pigen" link1="_0x84bb4a" method="_0xa"/>
                              </actions>
                           </program_sub>
                        </actions>
                        <actions id="_0x84d366" name="Ellers er spisekarnappen slukket" icon="_0x8">
                           <program_sub id="_0x84d41f" name="Er der andet lys i stuen?" icon="_0x7" note="Billedlyset slukkes kun, hvis ingen af de fire andre stuelamper er tændt. Er der lys, bliver det stående og slukkes som normalt sammen med resten af stuen.">
                              <conditions id="_0x84d565" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                                 <condition id="_0x84d6c9" name="%P = OFF" icon="_0x1a" note="De røde lamper er slukket" link1="_0x84ae11" method="_0x14"/>
                                 <condition id="_0x84d7c9" name="%P = OFF" icon="_0x1a" note="Standerlampen er slukket" link1="_0x84b111" method="_0x14"/>
                                 <condition id="_0x84d8c9" name="%P = OFF" icon="_0x1a" note="Lampen ved pladespilleren er slukket" link1="_0x84b411" method="_0x14"/>
                                 <condition id="_0x84d9c9" name="%P = OFF" icon="_0x1a" note="Billedbelysningen over klaveret er slukket" link1="_0x84b711" method="_0x14"/>
                              </conditions>
                              <actions id="_0x84da66" name="Ingen andre lamper tændt - sluk billedlyset" icon="_0x8" type="_0x1">
                                 <action id="_0x84dbca" name="Fremkald %P" icon="_0x9" note="Slukker billedlyset over pigen" link1="_0x84be4a" method="_0xa"/>
                              </actions>
                           </program_sub>
                        </actions>
                     </program_sub>
                  </actions>
               </program_simple>
            </programs>
         </functionblock>
      </group>
