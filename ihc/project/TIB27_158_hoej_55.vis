               <resource_integer id="_0x263c0b" name="TrykCount" note="Bruges til at indikere at vi har registreret det første tryk"/>
               <resource_timer id="_0x263d10" name="PulsTimer" icon="_0x43" note="Hvis der ikke er tale om dobbelt tryk, så simuleres et normalt tryk/slip på output-tryk med denne timer" hour="0" minute="0" second="0" millisecond="100"/>
            </internalsettings>
