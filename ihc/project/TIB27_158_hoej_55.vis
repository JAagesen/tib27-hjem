         <functionblock id="_0x263228" name="DobbeltTryk v3" master_name="DobbeltTryk v3" master_programmer="thomashe" master_date_year="2014" master_date_month="4" master_date_day="12" locked="yes" icon="_0x10" note="Dedekterer et dobbelt-tryk og pulserer dobbelt-tryk udgang.&#xD;&#xA;Hvis ikke der er tale om dobbelt tryk, sendes tryk videre til alm tryk output&#xD;&#xA;&#xD;&#xA;v3: Kommentarer tilføjet">
            <inputs id="_0x263323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x263411" name="Tryk" icon="_0x36" note="Forbindes til knappen som skal kunne udløse et tryk eller dobbelttryk."/>
               <resource_input id="_0x263511" name="DobbeltTryk" icon="_0x36" note="Giver mulighed for at udløse et dobbelttryk direkte. Anvendes ikke i normale situationer"/>
            </inputs>
            <outputs id="_0x263624" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x263712" name="Tryk" icon="_0x39" note="Denne udgang pulseres når det er konstateret at et tryk ikke var et dobbelttryk.&#xD;&#xA;&#xD;&#xA;Langt tryk er supporteret.  Hvis knappen holdes inde, vil denne udgang forblive ON indtil knappen slippes."/>
               <resource_output id="_0x263812" name="DobbeltTryk" icon="_0x39" note="Denne udgang går ON når dobbelt tryk dedekteres.  &#xD;&#xA;&#xD;&#xA;Lang tryk er supporteret.  Hvis knappen holdes inde efter et dobbelt tryk, forbliver denne udgang ON indtil knappen slippes."/>
            </outputs>
