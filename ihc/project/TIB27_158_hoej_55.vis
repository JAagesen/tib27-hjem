         <functionblock id="_0x844628" name="Efterkontrol af lys under overskabe" master_name="Efterkontrol af lys under overskabe" master_programmer="Jan Bjerre Aagesen" master_date_year="2026" master_date_month="10" master_date_day="12" icon="_0xf" note="Efterkontrol af lyset under overskabene (tilføjet 2026-10-12).&#xD;&#xA;&#xD;&#xA;Dæmperen i eltavlen rammer ikke altid det niveau den får besked på. Blokken venter derfor et øjeblik efter at lyset er tændt og retter op på 80 %, hvis niveauet er for lavt OG det ikke var køkken-PIR&apos;en der tændte. PIR&apos;ens egen nattænding røres altså ikke.&#xD;&#xA;&#xD;&#xA;Blokken slukker også overskabslyset ved Sluk Alt via et scenarie med en fast værdi, i stedet for den rå &quot;Regulér ned&quot;-besked der sad direkte på dæmperkanalen.">
            <inputs id="_0x844723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x844811" name="Lys indikering" icon="_0x36" note="Lys indikering fra LED-dæmperens kanal til overskabene">
                  <link_to_resource id="_0x84492c" name="Følg Link" icon="_0x4a" link="_0x844a2d"/>
               </resource_input>
               <resource_light_level id="_0x844b13" name="Lys niveau" note="Opret link mellem dæmperkanalens &quot;Lys niveau&quot; og denne indgang. Uden den kan blokken ikke se hvad lyset faktisk står på.">
                  <link_to_resource id="_0x844c2c" name="Følg Link" icon="_0x4a" link="_0x844d2d"/>
               </resource_light_level>
               <resource_input id="_0x844e11" name="Køkken-PIR tændt" icon="_0x36" note="Udgangen fra køkkenets PIR-styring. Er den ON, var det PIR&apos;en der tændte, og niveauet skal ikke rættes.">
                  <link_to_resource id="_0x844f2c" name="Følg Link" icon="_0x4a" link="_0x84502d"/>
               </resource_input>
               <resource_input id="_0x845111" name="Sluk Alt" icon="_0x36" note="Puls fra Sluk Alt">
                  <link_to_resource id="_0x84522c" name="Følg Link" icon="_0x4a" link="_0x84532d"/>
               </resource_input>
               <resource_enum id="_0x847d0f" name="Status Lys i Stue" typedef="_0x3b2d47" inivalue="_0x3b3248" icon="_0x22" note="Fra Scenarie funktion Stor Stue. Kører der et stue-scenarie (TV, Nat, Dag, Fuldt Lys), er det lave niveau med vilje, og der skal ikke rættes.">
                  <link_to_resource id="_0x847e2c" name="Følg Link" icon="_0x4a" link="_0x847f2d"/>
               </resource_enum>
               <resource_input id="_0x848211" name="Køkken tænd-tast" icon="_0x36" note="Samme tast som tænder køkkenlyset: midt venstre på de to 6-tast-paneler i stuen og Tryk 3 på fjernbetjeningen. Efterkontrollen kører kun efter et tryk her - ikke når et scenarie, PIR&apos;en eller IHC-appen tænder lyset.">
                  <link_to_resource id="_0x84832c" name="Følg Link" icon="_0x4a" link="_0x84842d"/>
                  <link_to_resource id="_0x84852c" name="Følg Link" icon="_0x4a" link="_0x84862d"/>
                  <link_to_resource id="_0x84872c" name="Følg Link" icon="_0x4a" link="_0x84882d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x845424" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x84554a" name="Sæt 80 %" note="Sætter overskabslyset til 80 % - samme niveau som Dag-scenariet" icon="_0x47" hide_dialog="yes">
                  <scene_link id="_0x84564b" name="Scenarie link" icon="_0x47" link="_0x84574c"/>
               </resource_scene>
               <resource_scene id="_0x84584a" name="Sluk overskabe" note="Slukker overskabslyset med en fast værdi" icon="_0x47" hide_dialog="yes">
                  <scene_link id="_0x84594b" name="Scenarie link" icon="_0x47" link="_0x845a4c"/>
               </resource_scene>
            </outputs>
            <settings id="_0x845b25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timertime id="_0x845c17" name="Kontroltid" icon="_0x4d" note="Hvor lang tid der ventes efter tænding, før niveauet kontrolleres. Skal være længere end den længste rampe (5 sekunder)." hour="0" minute="0" second="8" millisecond="0"/>
            </settings>
            <internalsettings id="_0x845d29" name="Interne variable" icon="_0x13" note="Private variable til funktionsblokken">
               <resource_timer id="_0x845e10" name="Kontroller om" icon="_0x43" hour="0" minute="0" second="0" millisecond="0"/>
            </internalsettings>
            <programs id="_0x845f26" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x84601e" name="Der trykkes på køkken-tasten" icon="_0x7" note="Starter kontroluret, når køkkenlyset tændes med hånden. Scenarier, PIR og IHC-appen udløser den ikke.">
                  <events id="_0x846164" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x8462c8" name="%P -&gt; ON" icon="_0xc" note="Start program når der trykkes på køkkenets tænd-tast" link1="_0x848211" method="_0xa"/>
                  </events>
                  <actions id="_0x846366" name="Kommandoer" icon="_0x8" note="Kommandoer" type="_0x2">
                     <action id="_0x8464ca" name="%P = %S" icon="_0x9" note="Sætter %P lig med %S" link1="_0x845e10" link2="_0x845c17" method="_0x1e"/>
                     <action id="_0x8465ca" name="Aktiver nedtælling på %P" icon="_0x9" note="Aktiver nedtælling på %P" link1="_0x845e10" method="_0xd2"/>
                  </actions>
               </program_simple>
               <program_simple id="_0x84661e" name="Efterkontrol" icon="_0x7" note="Kontrollerer niveauet, når uret er løbet ud">
                  <events id="_0x846764" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x8468c8" name="%P -&gt; 0" icon="_0xc" note="Start program når %P skifter til 0" link1="_0x845e10" method="_0xa"/>
                  </events>
                  <actions id="_0x846966" name="Kommandoer" icon="_0x8" note="Kommandoer" type="_0x2">
                     <program_sub id="_0x846a1f" name="Står lyset for lavt uden en god grund?" icon="_0x7" note="Der rættes kun op, hvis lyset er tændt med hånden: ikke af køkken-PIR&apos;en, og ikke som del af et stue-scenarie. TV (20 %) og Nat (7 %) dæmper med vilje og skal have lov.">
                        <conditions id="_0x846b65" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                           <condition id="_0x846cc9" name="%P &lt; %S" icon="_0x1a" note="Lyset står lavere end det skal" link1="_0x844b13" link2="_0x846d13" method="_0x3c">
                              <resource_light_level id="_0x846d13" name="Lys niveau" inivalue="70"/>
                           </condition>
                           <condition id="_0x846ec9" name="%P = OFF" icon="_0x1a" note="Det var ikke køkken-PIR&apos;en der tændte" link1="_0x844e11" method="_0x14"/>
                           <condition id="_0x8480c9" name="%P = %S" icon="_0x1a" note="Der kører ikke et stue-scenarie - TV og Nat dæmper med vilje" link1="_0x847d0f" link2="_0x84810f" method="_0x1e">
                              <resource_enum id="_0x84810f" name="Enumerator" typedef="_0x3b2d47" inivalue="_0x3b3248" icon="_0x22"/>
                           </condition>
                        </conditions>
                        <actions id="_0x846f66" name="Kommandoer ved betingelser sande" icon="_0x8" note="Sæt niveauet op på 80 %" type="_0x1">
                           <action id="_0x8470ca" name="Fremkald %P" icon="_0x9" note="Sætter overskabslyset til 80 %" link1="_0x84554a" method="_0xa"/>
                        </actions>
                        <actions id="_0x847166" name="Kommandoer ved betingelser falske" icon="_0x8" note="Niveauet er i orden - gør ingenting"/>
                     </program_sub>
                  </actions>
               </program_simple>
               <program_simple id="_0x84721e" name="Sluk Alt slukker overskabslyset" icon="_0x7" note="Slukker med en fast scenarie-værdi og standser kontroluret, så lyset ikke bliver tændt igen af efterkontrollen">
