                  <link_to_resource id="_0x7c882c" name="Følg Link" icon="_0x4a" link="_0x7c872d"/>
                  <link_to_resource id="_0x81da2c" name="Følg Link" icon="_0x4a" link="_0x81d92d"/>
               </resource_input>
               <resource_input id="_0x746511" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
