         <functionblock id="_0x52e128" name="PIR styring Køkken -  Tænd om Natten (Skumringsrelæ) og når lys i Stue er slukket" master_name="PIR styring " master_programmer="jan" master_date_year="2020" master_date_month="12" master_date_day="30" icon="_0xf" note="1.4.02.a. PIR styring &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til simpel styring af IHC Wireless produkter og relæer ifm. PIR og manuel betjening.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x52eb23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x52ec11" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstillinger:&#xD;&#xA; &quot;# PIR funktion&quot;&#xD;&#xA; &quot;# PIR funktion nat&quot;&#xD;&#xA;(Udfyldes af installatøren)">
                  <link_to_resource id="_0x543b2c" name="Følg Link" icon="_0x4a" link="_0x543a2d"/>
               </resource_input>
               <resource_input id="_0x52ed11" name="Skumring" backup="yes" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;Alternativt via ur funktionsblok.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" inivalue="on">
                  <link_to_resource id="_0x64382c" name="Følg Link" icon="_0x4a" link="_0x64372d"/>
               </resource_input>
               <resource_input id="_0x52ee11" name="Tilbagemelding" icon="_0x36" note="Opret link mellem produktets &quot;Udgang&quot; og &quot;Tilbagemelding&quot;.&#xD;&#xA;Ved tilbagemelding begrænses genkald af IHC Wireless produkter ifm. PIR aktivitet.">
                  <link_to_resource id="_0x72a72c" name="Følg Link" icon="_0x4a" link="_0x72a62d"/>
               </resource_input>
               <resource_input id="_0x52ef11" name="Natdrift" icon="_0x36" note="Anvendes som begrænsning for PIR funktion om natten.&#xD;&#xA;(Udfyldes af installatøren)">
                  <link_to_resource id="_0x543d2c" name="Følg Link" icon="_0x4a" link="_0x543c2d"/>
               </resource_input>
               <resource_input id="_0x52f011" name="Kip" icon="_0x36" note="Kipper udgang og scenarier&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x52f111" name="Tænd" icon="_0x36" note="Tænder udgang og scenarie &#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x52f211" name="Sluk" icon="_0x36" note="Slukker udgang og scenarie.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x52f311" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_enum id="_0x54270f" name="Status Lys i Stue" typedef="_0x3b2d47" inivalue="_0x3b3248" icon="_0x22">
                  <link_to_resource id="_0x542f2c" name="Følg Link" icon="_0x4a" link="_0x542e2d"/>
               </resource_enum>
               <resource_enum id="_0x7d410f" name="Status Lys i Køkken" typedef="_0x7d3c47" inivalue="_0x7d3e48" backup="yes" icon="_0x22">
