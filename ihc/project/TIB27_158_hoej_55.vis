         <functionblock id="_0x80c228" name="Markise HA-bro" master_name="Markise HA-bro" master_programmer="Jan Bjerre Aagesen" master_date_year="2026" master_date_month="7" master_date_day="20" icon="_0xf" note="Bro til Home Assistant.&#xD;&#xA;&#xD;&#xA;Spejler fire taster over i fire signalflag, som Home Assistant læser via IHC-integrationen og omsætter til Somfy-kommandoer.&#xD;&#xA;&#xD;&#xA;Tryk UD / Tryk IND: ét tryk = kør helt ud / helt ind. Flaget holdes ON i mindst 1 sek. (indstilling), så HA ikke misser korte tryk.&#xD;&#xA;Hold UD / Hold IND: ON kun mens tasten holdes nede.&#xD;&#xA;UD og IND spærrer for hinanden.&#xD;&#xA;&#xD;&#xA;Opdateret 2026-09-16.">
            <inputs id="_0x80c323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x80c411" name="Tryk UD" icon="_0x36" note="Ét tryk kører markisen helt ud">
                  <link_to_resource id="_0x80f92c" name="Følg Link" icon="_0x4a" link="_0x80f82d"/>
               </resource_input>
               <resource_input id="_0x80c511" name="Tryk IND" icon="_0x36" note="Ét tryk kører markisen helt ind">
                  <link_to_resource id="_0x80fb2c" name="Følg Link" icon="_0x4a" link="_0x80fa2d"/>
               </resource_input>
               <resource_input id="_0x80c611" name="Hold UD" icon="_0x36" note="Markisen kører ud så længe tasten holdes nede">
                  <link_to_resource id="_0x80fd2c" name="Følg Link" icon="_0x4a" link="_0x80fc2d"/>
               </resource_input>
               <resource_input id="_0x80c711" name="Hold IND" icon="_0x36" note="Markisen kører ind så længe tasten holdes nede">
                  <link_to_resource id="_0x80ff2c" name="Følg Link" icon="_0x4a" link="_0x80fe2d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x80c824" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
