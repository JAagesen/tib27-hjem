         <functionblock id="_0x32a528" name="Styring af PIR i gang i forhold til lys i stuen" master_name="Styring af PIR i forhold til lys i stuen" master_programmer="jan" master_date_year="2021" master_date_month="4" master_date_day="5" icon="_0xf" note="1.2.05. Trådløs lysdæmperstyring&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af IHC Wireless lysdæmper ifm. PIR og IHCRemote og IHCTablet app.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering.&#xD;&#xA;Kan fremkalde/gemme to scenarier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x32c223" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x32c311" name="Touch " icon="_0x36" note="Kort tryk tænd/sluk - langt tryk regulerer lys niveau op/ned.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x32c411" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x32c511" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x32c611" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x39cc11" name="Mellem" icon="_0x36"/>
               <resource_input id="_0x32c711" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_light_level id="_0x32c813" name="Lys niveau " note="Opret link mellem produktets &quot;Lys niveau&quot; og denne indgang.&#xD;&#xA;Funktionsblokken virker ikke korrekt uden denne sammenhæng.&#xD;&#xA;">
                  <link_to_resource id="_0x851a2c" name="Følg Link" icon="_0x4a" link="_0x85192d"/>
               </resource_light_level>
               <resource_input id="_0x32c911" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x32ca11" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstilling &quot;# PIR funktion&quot; og &quot;# PIR funktion nat&quot;.&#xD;&#xA;(Udfyldes af installatøren)">
                  <link_to_resource id="_0x36612c" name="Følg Link" icon="_0x4a" link="_0x36602d"/>
               </resource_input>
               <resource_input id="_0x32cb11" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" inivalue="on">
                  <link_to_resource id="_0x6c7c2c" name="Følg Link" icon="_0x4a" link="_0x6c7b2d"/>
               </resource_input>
               <resource_input id="_0x32cc11" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x39a511" name="Lys i Stue" icon="_0x36">
                  <link_to_resource id="_0x39d02c" name="Følg Link" icon="_0x4a" link="_0x39cf2d"/>
                  <link_to_resource id="_0x71e92c" name="Følg Link" icon="_0x4a" link="_0x71e82d"/>
                  <link_to_resource id="_0x71eb2c" name="Følg Link" icon="_0x4a" link="_0x71ea2d"/>
                  <link_to_resource id="_0x71ed2c" name="Følg Link" icon="_0x4a" link="_0x71ec2d"/>
                  <link_to_resource id="_0x71ef2c" name="Følg Link" icon="_0x4a" link="_0x71ee2d"/>
               </resource_input>
               <resource_input id="_0x39f711" name="Indgang UR" icon="_0x36" note="Checker status på ur i forhold til lys i stue"/>
               <resource_enum id="_0x3b7a0f" name="Status Lys i Stue" typedef="_0x3b2d47" inivalue="_0x3b3248" icon="_0x22">
                  <link_to_resource id="_0x3b7c2c" name="Følg Link" icon="_0x4a" link="_0x3b7b2d"/>
               </resource_enum>
               <resource_input id="_0x822611" name="Tryk NAT" icon="_0x36" note="Sætter gangen i natdrift. Virker kun når det er mørkt udenfor.">
                  <link_to_resource id="_0x82302c" name="Følg Link" icon="_0x4a" link="_0x822f2d"/>
               </resource_input>
               <resource_input id="_0x84e411" name="Tryk NAT soveværelse" icon="_0x36" note="NAT-tasterne i soveværelset. Slukker gangen straks og venter på ny bevægelse, før PIR&apos;en må tænde igen.">
                  <link_to_resource id="_0x822a2c" name="Følg Link" icon="_0x4a" link="_0x82292d"/>
                  <link_to_resource id="_0x822c2c" name="Følg Link" icon="_0x4a" link="_0x822b2d"/>
               </resource_input>
               <resource_input id="_0x822711" name="Tryk DAG" icon="_0x36" note="Sætter gangen tilbage til dagdrift. Virker altid.">
                  <link_to_resource id="_0x82322c" name="Følg Link" icon="_0x4a" link="_0x82312d"/>
                  <link_to_resource id="_0x82342c" name="Følg Link" icon="_0x4a" link="_0x82332d"/>
                  <link_to_resource id="_0x82382c" name="Følg Link" icon="_0x4a" link="_0x82372d"/>
               </resource_input>
               <resource_input id="_0x839811" name="Nat-ur" icon="_0x36" note="ON mellem nat-tidspunktet og morgen. Kommer fra uret &quot;2.1.01.a. Styring af Natfunktion på PIR&quot; i gruppen Fælles. Bruges til at holde gangen ude af natdrift, før tidspunktet er nået.">
                  <link_to_resource id="_0x83992c" name="Følg Link" icon="_0x4a" link="_0x839a2d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x32cd24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x83604a" name="Manuel regulering" note="Bruges kun når man holder en af de nederste taster inde. IHC gemmer det niveau, man slipper ved, i dette scenarie - derfor må det ikke deles med de faste niveauer." hide_dialog="yes">
                  <scene_link id="_0x85284b" name="Scenarie link" icon="_0x47" link="_0x85274c"/>
               </resource_scene>
               <resource_scene id="_0x32ce4a" name="Højt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;Default 100%, rampetid 1 sek." hide_dialog="yes">
                  <scene_link id="_0x85264b" name="Scenarie link" icon="_0x47" link="_0x85254c"/>
               </resource_scene>
               <resource_scene id="_0x39cb4a" name="Mellem Niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;">
                  <scene_link id="_0x852e4b" name="Scenarie link" icon="_0x47" link="_0x852d4c"/>
               </resource_scene>
               <resource_scene id="_0x32cf4a" name="Lavt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;">
                  <scene_link id="_0x852a4b" name="Scenarie link" icon="_0x47" link="_0x85294c"/>
               </resource_scene>
               <resource_scene id="_0x32d04a" name="Sluk" note="Forbindes til lysdæmperen med 0% lysniveau og den ønskede rampetid.&#xD;&#xA;Ved automatisk sluk benyttes den valgte rampetid og ved manuel sluk benyttes default tiden i lysdæmperen (700ms) for &quot;softsluk&quot;.&#xD;&#xA;">
                  <scene_link id="_0x852c4b" name="Scenarie link" icon="_0x47" link="_0x852b4c"/>
               </resource_scene>
               <resource_scene id="_0x82774a" name="Nat nedtoning (1 %)" note="Blid nedtoning til natniveau, 1 % over 5 sekunder" hide_dialog="yes">
                  <scene_link id="_0x85304b" name="Scenarie link" icon="_0x47" link="_0x852f4c"/>
               </resource_scene>
               <resource_scene id="_0x83ff4a" name="Højt niveau blødt" note="Som &quot;Højt niveau&quot;, men med lang rampetid. Bruges når ganglyset allerede er tændt på lav eller mellem." hide_dialog="yes">
                  <scene_link id="_0x85324b" name="Scenarie link" icon="_0x47" link="_0x85314c"/>
               </resource_scene>
               <resource_scene id="_0x84784a" name="Sluk hurtigt (1 sek.)" note="Som &quot;Sluk&quot;, men med 1 sekunds rampetid. Bruges når ganglyset slukkes på en tast og det er mørkt udenfor." hide_dialog="yes">
                  <scene_link id="_0x85344b" name="Scenarie link" icon="_0x47" link="_0x85334c"/>
               </resource_scene>
               <resource_scene id="_0x84e54a" name="Sluk straks (soveværelset)" note="Som &quot;Sluk&quot;, men næsten uden rampe (200 ms). Bruges kun af NAT-tasterne i soveværelset." hide_dialog="yes">
                  <scene_link id="_0x85364b" name="Scenarie link" icon="_0x47" link="_0x85354c"/>
               </resource_scene>
               <resource_scene id="_0x84894a" name="Fuldt lys (100 %)" note="Rengøringsscenariet: gangen på 100 % med 1 sekunds rampe. Niveau og rampetid ændres frit her." hide_dialog="yes">
                  <scene_link id="_0x85384b" name="Scenarie link" icon="_0x47" link="_0x85374c"/>
               </resource_scene>
               <resource_enum id="_0x32d10f" name="Lysdæmper status" typedef="_0x2eec47" inivalue="_0x2eee48" backup="yes" icon="_0x22" note="Status indikering til Viewer."/>
               <resource_timer id="_0x32d210" name="Efterløb udløber om" icon="_0x43" note="Bemærk:&#xD;&#xA;Hvis efterløb viser 00:00:00,000 er efterløb deaktiveret.&#xD;&#xA;" hour="0" minute="0" second="0" millisecond="0"/>
               <resource_output id="_0x32d312" name="Manuelt betjent " backup="yes" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR."/>
               <resource_output id="_0x32d412" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer."/>
            </outputs>
            <settings id="_0x32d525" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x32d60f" name="Kort reguleringstryk tænder" typedef="_0x2ee847" inivalue="_0x2ee948" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
               <resource_enum id="_0x32d70f" name="Manuel betjening" typedef="_0x2efd47" inivalue="_0x2eff48" backup="yes" icon="_0x22" note="Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb dag/aften efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Starter ekstra efterløb til sluk&quot; vil lys slukke på ekstra efterløb til sluk efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv."/>
               <resource_enum id="_0x32d80f" name="PIR funktion " typedef="_0x2ef647" inivalue="_0x3a4c48" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Trin høj/sluk&#xD;&#xA;Trin høj/mellem&#xD;&#xA;Trin høj/mellem/sluk&#xD;&#xA;Trin høj/mellem/+ekstra efterløb&#xD;&#xA;Trin høj/lav&#xD;&#xA;Trin høj/lav/sluk&#xD;&#xA;Trin høj/lav/+ekstra efterløb til sluk&#xD;&#xA;Trin mellem&#xD;&#xA;Trin lav/sluk&#xD;&#xA;Dag/aften slukkes kun lys"/>
               <resource_enum id="_0x32d90f" name="PIR funktion nat" typedef="_0x2ee547" inivalue="_0x2ee648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Trin lav/sluk&quot; kan benyttes til alle rum - dog ikke soverum.&#xD;&#xA;&quot;Kun efterløb&quot; benyttes til soverum og andre rum der ønskes undtaget."/>
               <resource_timertime id="_0x32da17" name="Efterløb dag/aften" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for dag/aften." hour="0" minute="3" second="0" millisecond="0"/>
               <resource_timertime id="_0x32db17" name="Efterløb nat" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for natdrift." hour="0" minute="0" second="0" millisecond="1"/>
               <resource_timertime id="_0x32dc17" name="Ekstra efterløb til sluk " backup="yes" icon="_0x4d" note="Her indstilles ekstra efterløbstid.&#xD;&#xA;Benyttes ifm. disse valg:&#xD;&#xA;&quot;PIR funktion = Trin høj/lav/+ekstra efterløb til sluk&quot; &#xD;&#xA;&quot;Manuel betjening = Aktivt ekstra efterløb til sluk&quot;&#xD;&#xA;Efter sidste påvirking af PIR, tryk eller app regulering vil lys afhængig af opsætning slukke med den valgte initial værdi." hour="0" minute="10" second="0" millisecond="0"/>
               <resource_timertime id="_0x840217" name="Efterløb høj når stuelys er tændt" backup="yes" icon="_0x4d" note="Efterløbstid på højt niveau når lyset i stuen er tændt (PIR funktion = Trin høj/mellem). Er stuelyset slukket, bruges &quot;Efterløb dag/aften&quot;." hour="0" minute="10" second="0" millisecond="0"/>
               <resource_timer id="_0x827a17" name="Efterløb efter nat-nedtoning" backup="yes" icon="_0x43" note="Tid fra nedtoningen starter, til ganglyset slukker. 5 sek. bruges på selve nedtoningen." hour="0" minute="0" second="15" millisecond="0"/>
            </settings>
            <internalsettings id="_0x32dd29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x32de10" name="Spærring af PIR efter manuel sluk " icon="_0x43" note="Hvor længe PIR&apos;en holdes tilbage efter en manuel slukning, så lyset ikke tænder igen, mens man stadig er i gangen." hour="0" minute="0" second="45" millisecond="0"/>
               <resource_timer id="_0x32df10" name="Gem nyt scenarie efter " icon="_0x43" hour="0" minute="0" second="3" millisecond="0"/>
               <resource_timer id="_0x32e010" name="Kvittér med blink af scenarie" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
               <resource_timer id="_0x32e110" name="Kvittér med blink efter manuel sluk" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
               <resource_timer id="_0x32e210" name="Spærring" icon="_0x43" hour="0" minute="0" second="0" millisecond="50"/>
               <resource_timer id="_0x32e310" name="Spærring %" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
               <resource_timer id="_0x32e410" name="Status check" icon="_0x43" note="Vagthundens interval. 20 sekunder, så den aldrig måler midt i en ramp (længste ramp er 10 s)." hour="0" minute="0" second="20" millisecond="0"/>
               <resource_timer id="_0x32e510" name="Max tryktid" icon="_0x43" hour="0" minute="0" second="0" millisecond="400"/>
               <resource_timer id="_0x32e610" name="Min. regulering 1" icon="_0x43" hour="0" minute="0" second="0" millisecond="600"/>
               <resource_timer id="_0x32e710" name="Min. regulering 2" icon="_0x43" hour="0" minute="0" second="0" millisecond="600"/>
               <resource_flag id="_0x32e80a" name="Flag for manuel " backup="yes" icon="_0x33"/>
               <resource_flag id="_0x32e90a" name="Reg. retning" icon="_0x33"/>
               <resource_flag id="_0x32ea0a" name="Oneshot man" backup="yes" icon="_0x33"/>
               <resource_flag id="_0x32eb0a" name="PIR årsag til tænding" icon="_0x33"/>
               <resource_flag id="_0x82280a" name="Afventer nat" icon="_0x33" note="ON når natten venter på, at ganglyset er trappet helt ned."/>
               <resource_timer id="_0x832f10" name="Tryktid DAG" icon="_0x43" note="Skelner kort fra langt tryk på DAG-tasten. Under 1 sekund = kort tryk. Ændres frit her, hvis tasten skal være mere eller mindre tålmodig." hour="0" minute="0" second="1" millisecond="0"/>
               <resource_timer id="_0x836310" name="Tryktid NAT" icon="_0x43" note="Skelner kort fra langt tryk på NAT-tasten. Under 1 sekund = kort tryk. Ændres frit her, hvis tasten skal være mere eller mindre tålmodig." hour="0" minute="0" second="1" millisecond="0"/>
               <resource_flag id="_0x848c0a" name="Fuldt lys aktivt" icon="_0x33" note="ON mens rengøringsscenariet (Fuldt lys) kører. Holder gangen på 100 %: hverken PIR eller efterløb trapper ned, så længe flaget er sat."/>
               <resource_flag id="_0x84e80a" name="Vent på ny bevægelse" icon="_0x33" note="Sat når gangen slukkes fra soveværelset mens PIR står på ON. PIR&apos;en må ikke tænde lyset før den har været OFF og ser ny bevægelse."/>
            </internalsettings>
            <programs id="_0x32ec26" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x348d1e" name="PIR aktiveres" icon="_0x7" note="PIR&apos;en gensender ALTID niveauet, når den aktiveres - den ser ikke længere på, hvad blokken tror lampen står på.&#xD;&#xA;&#xD;&#xA;Det betyder, at lyset kan tændes igen af PIR&apos;en efter en manuel slukning på en kontakt, både i dagdrift og i natdrift, på det niveau der er sat i scenariet.">
                  <events id="_0x348e64" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x348fc8" name="%P -&gt; ON" icon="_0xc" note="Start program når %P skifter til ON" link1="_0x32ca11" method="_0xa"/>
                     <event id="_0x3491c8" name="%P -&gt; OFF" icon="_0xc" note="Start program når %P skifter til OFF" link1="_0x32e80a" method="_0x14"/>
                     <event id="_0x3495c8" name="%P -&gt; OFF" icon="_0xc" note="Start program når %P skifter til OFF" link1="_0x32cc11" method="_0x14"/>
                     <event id="_0x3492c8" name="%P -&gt; %S" icon="_0xc" note="Start program når %P skifter til %S" link1="_0x32d10f" link2="_0x34930f" method="_0x1e">
                        <resource_enum id="_0x34930f" name="Enumerator" typedef="_0x2eec47" inivalue="_0x2eee48" icon="_0x22"/>
                     </event>
                  </events>
                  <actions id="_0x349666" name="Kommandoer" icon="_0x8" note="Gruppering af kommandoer som udføres når hændelse er indtruffet" type="_0x2">
                     <program_sub id="_0x34971f" name="Under program" icon="_0x7">
                        <conditions id="_0x349865" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                           <condition id="_0x3499c9" name="%P = ON" icon="_0x1a" note="Betingelse at %P er ON" link1="_0x32ca11" method="_0xa"/>
                           <condition id="_0x349ac9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x32cc11" method="_0x14"/>
                           <condition id="_0x349bc9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x32e80a" method="_0x14"/>
                           <condition id="_0x349cc9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x32c611" method="_0x14"/>
                           <condition id="_0x39d1c9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x39cc11" method="_0x14"/>
                           <condition id="_0x349dc9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x32c711" method="_0x14"/>
                           <condition id="_0x84e9c9" name="%P = OFF" icon="_0x1a" note="Ikke hvis gangen er slukket fra soveværelset og PIR&apos;en endnu ikke har været i ro" link1="_0x84e80a" method="_0x14"/>
                        </conditions>
                        <actions id="_0x34a266" name="Kommandoer ved betingelser sande" icon="_0x8" note="Gruppering af kommandoer som udføres når betingelser er sande" type="_0x1">
                           <program_sub id="_0x34a31f" name="Højt niveau  (Natdrift inaktiv)" icon="_0x7">
                              <conditions id="_0x34a465" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test">
                                 <condition id="_0x34a5c9" name="%P = OFF" icon="_0x1a" note="Betingelse at %P er OFF" link1="_0x32c911" method="_0x14"/>
                                 <conditions id="_0x34a865" name="Betingelser" icon="_0x16" note="Gruppering af betingelser til logisk test" type="or">
                                    <condition id="_0x34a9c9" name="%P = %S" icon="_0x1a" note="Betingelse at %P er samme som %S" link1="_0x32d80f" link2="_0x34aa0f" method="_0x1e">
