               <resource_input id="_0x1f2b11" name="Reguler ned" icon="_0x36" note="Kort tryk Sluk - Langt tryk regulére lys niveau ned&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x1f2c11" name="Nat" icon="_0x36" note="Forbindes til funktionsblok &#xD;&#xA;&quot;4.2.06. Dag og Nat&quot; - &quot;Dag og Nat&quot; eller &#xD;&#xA;&quot;9.2.01. Bolig® Master&quot; -&quot;Nat&quot;"/>
               <resource_input id="_0x1f2d11" name="Lys indikering" icon="_0x36" note="Forbindes til Lys indikering fra Wireless dimmer"/>
            </inputs>
