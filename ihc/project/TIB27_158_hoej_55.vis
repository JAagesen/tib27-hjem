         <functionblock id="_0x20b728" name="4.2.06. Dag og Nat" master_schneider_electric="yes" master_type="4.2.06" master_name="Dag og Nat" master_programmer="Lauritz Knudsen&#xD;&#xA;Schneider Electric Danmark A/S&#xD;&#xA;Copyright 2013" master_date_year="2013" master_date_month="8" master_date_day="20" locked="yes" icon="_0xe" note="4.2.06 Nat og Dag&#xD;&#xA;&#xD;&#xA;Anvendelse til at slukke lys i udvalgte rum og sætte huset i &quot;NAT-Tilstand&quot;, &#xD;&#xA;når familien er går i seng. &#xD;&#xA;På Visility DashBoard vises tilstand for Dag eller Nat. Tilstand kan skiftes ved tryk på ikon.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !&#xD;&#xA;Denne FB er kompatibel med &quot;Visility Dashboard&quot;" udf="#DBScenario#">
            <inputs id="_0x216223" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x216311" name="Skift Dag/Nat" icon="_0x36" note="Skifter mellem Nat og Dag&#xD;&#xA;Denne er afhæning af &quot;Tryk betingelser&quot;&#xD;&#xA;&quot;Tryk - Uafhængigt af tryktid&quot; - Skifter mellem Nat og Dag , uanset tryktid.&#xD;&#xA;&quot;Langt tryk &gt; 0,7 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt;0.7 sekund = &quot;Nat&quot; &quot;&#xD;&#xA;&quot;X-langt tryk &gt; 1 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt; 1 sekund = &quot;Nat&quot; &#xD;&#xA;&quot;X-langt tryk &gt; 2 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt; 2 sekund = &quot;Nat&quot; "/>
               <resource_input id="_0x216411" name="Nat" icon="_0x36" note="Skifter til &quot;Nat&quot; - Uanset tryktid"/>
               <resource_input id="_0x216511" name="Dag" icon="_0x36" note="Skifter til &quot;Dag&quot; - Uanset tryktid"/>
               <resource_input id="_0x216611" name="Indgang for Pir" icon="_0x36" note="Forbindes til en eller flere pir &#xD;&#xA;Anvendes kun ved &quot;Auto skift på = Ur og Pir&quot;&#xD;&#xA;Vælg under indstillinger &quot;Pir Type&quot; om det er en Lys pir eller en &quot;Alarm Pir&quot;.&#xD;&#xA;"/>
            </inputs>
            <outputs id="_0x216724" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x216812" name="Dag og Nat" backup="yes" icon="_0x39" note="Forbindes til de funktionsblokke der anvender &quot;Nat&quot; tilstand&#xD;&#xA;denne udgang er &quot;ON&quot; når &quot;Nat&quot; er aktiveret &#xD;&#xA;og &quot;OFF&quot; når &quot;Dag&quot; er aktiveret"/>
               <resource_scene id="_0x21694a" name="Scenarie Godnat" note="Fremkaldes kun når &quot;Nat&quot; aktivers.&#xD;&#xA;Forbindes til den produkter der skal slukke til Godnat."/>
               <resource_output id="_0x216a12" name="Puls - Nat" icon="_0x39" note="Kort puls , når &quot;Nat&quot; aktivers"/>
               <resource_output id="_0x216b12" name="Puls - Dag " icon="_0x39" note="Kort puls , når &quot;Nat&quot; aktivers"/>
            </outputs>
            <settings id="_0x216c25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x216d0f" name="Auto skift på" typedef="_0x76947" inivalue="_0x76b48" icon="_0x22" note="Betingelse for hvornår automatisk skift til &quot;Dag&quot; &#xD;&#xA;&quot;Ur&quot; - Når &quot;Tidspunkt for Dag&quot; opnås skifter funktionsblokken automatisk til &quot;Dag&quot; &#xD;&#xA;&quot;Ur og Pir&quot; -  Når &quot;Tidspunkt for Dag&quot; er opfyldt, vil autonatisk skift til &quot;Dag&quot; først ske når &quot;Indgang for Pir&quot; aktivers&#xD;&#xA;&quot;Manualt&quot; - Skifter ikke automatisk."/>
               <resource_time id="_0x216e0d" name="Tidspunkt for Dag" backup="yes" icon="_0x2f" note="Skifter til Dag når dette tisdpunkt er opnået.&#xD;&#xA;" hour="6" minute="30" second="0"/>
               <resource_enum id="_0x216f0f" name="Pir Type" typedef="_0x72047" inivalue="_0x72148" icon="_0x22" note="Vælg hvilken pir der er tilsluttet til blokken &#xD;&#xA;Vælg mellem Lys-pir og Alarm-pir"/>
            </settings>
            <internalsettings id="_0x217029" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_enum id="_0x21710f" name="DBScenario" typedef="_0x76d47" inivalue="_0x78b48" backup="yes" icon="_0x22" note="DBScenario" note-2="This enum control what icon is shown on the widget. This may be changes runtime by program. If value Hide is selected no icon is shown. Se documentation for icon id&apos;s." udf="#Scenario#"/>
               <resource_enum id="_0x21720f" name="Labelvalue" typedef="_0x72347" inivalue="_0x73148" backup="yes" icon="_0x22" note-2="Tekst som vises"/>
