         <functionblock id="_0x1f2328" name="1.2.04.a. Trådløs dimmer med nat" master_schneider_electric="yes" master_type="1.2.04" master_version="a" master_name="Trådløs dimmer med nat" master_programmer="Lauritz Knudsen&#xD;&#xA;Schneider Electric Danmark A/S&#xD;&#xA;Copyright 2013" master_date_year="2013" master_date_month="7" master_date_day="1" locked="yes" icon="_0xe" note="1.2.04.a Trådløs dimmer med natfunktion&#xD;&#xA;&#xD;&#xA;Anvendes:&#xD;&#xA;Til styring af trådløse lysdæmpere. Kan anvendes som 1- eller 2- tast betjent.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
