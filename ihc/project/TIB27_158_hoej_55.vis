                  <events id="_0x831c64" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x831dc8" name="%P -&gt; 0" icon="_0xc" note="Start program når %P skifter til 0" link1="_0x831310" method="_0xa"/>
