         <functionblock id="_0x196728" name="Uge Ur Generelt Tænd Sluk Hele huset" master_name="Uge ur" master_programmer="jan" master_date_year="2020" master_date_month="1" master_date_day="7" icon="_0xf" note="2.1.02.b  Uge - døgn - hverdag/weekend UR med indgang for overstyring samt deaktivering af ur-blok &#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Ugeur hvor det er muligt at have flere urtider på samme dag.&#xD;&#xA;Hvis UR er sat til 00:00:00 er dette UR DEAKTIVERET !&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x197e23" name="Input" icon="_0x4">
               <resource_input id="_0x197f11" name="Manuel kip af udgang" icon="_0x36" note="Manuel overstyring af Ur (Udfyldes af installatøren)"/>
               <resource_input id="_0x198011" name="Manuel tænd" icon="_0x36" note="Manuel Tænd af Ur (Udfyldes af installatøren)"/>
               <resource_input id="_0x198111" name="Manuel sluk" icon="_0x36" note="Manuel Sluk af Ur (Udfyldes af installatøren)"/>
               <resource_input id="_0x198211" name="Ur Aktiv" icon="_0x36" note="Skal være &quot;ON&quot; hvis uret skal være &quot;Aktiv&quot;&#xD;&#xA;Kan forbindes til Kalender funktionsblok eller Skumringsrelæ" inivalue="on"/>
            </inputs>
