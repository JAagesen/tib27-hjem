         <functionblock id="_0x830c28" name="HA hjerteslag" master_name="HA hjerteslag" master_programmer="Jan Bjerre Aagesen" master_date_year="2026" master_date_month="9" master_date_day="26" icon="_0xf" note="Hjerteslag til Home Assistant (tilføjet 2026-09-26).&#xD;&#xA;&#xD;&#xA;Udgangen &quot;HA hjerteslag&quot; kipper hvert 2. minut og 30 sekunder, døgnet rundt. Home Assistant læser den som binary_sensor og kan genstarte sig selv, hvis den holder op med at skifte.&#xD;&#xA;&#xD;&#xA;Flaget er rent virtuelt og må IKKE forbindes til en udgang eller et relæ.&#xD;&#xA;Funktionen starter selv ved opstart af controlleren og gen-armeres desuden hver nat kl. 03:00 for en sikkerheds skyld.">
            <outputs id="_0x830d24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_flag id="_0x830b0a" name="HA hjerteslag" icon="_0x33" note="Virtuelt flag. Kipper hvert 2:30. MÅ IKKE genbruges eller forbindes til en fysisk udgang."/>
            </outputs>
            <settings id="_0x830e25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timertime id="_0x831117" name="Halv periode" icon="_0x4d" note="Tid mellem to tilstandsskift. 2:30 giver et fuldt hjerteslag på 5 minutter." hour="0" minute="2" second="30" millisecond="0"/>
               <resource_time id="_0x83120d" name="Daglig gen-armering" icon="_0x4c" note="Tidspunkt hvor nedtællingen startes forfra som sikkerhedsnet" hour="3" minute="0" second="0"/>
            </settings>
            <internalsettings id="_0x830f29" name="Interne variable" icon="_0x13" note="Private variable til funktionsblokken">
               <resource_timer id="_0x831310" name="Hjerteslag timer" icon="_0x43" hour="0" minute="0" second="0" millisecond="0"/>
            </internalsettings>
            <programs id="_0x831026" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x83141e" name="Start hjerteslag" icon="_0x7" note="Starter nedtællingen ved opstart af controlleren og igen hver nat kl. 03:00">
                  <events id="_0x831564" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event_power id="_0x8316c8" name="Powerup" icon="_0xc" note="Starter program når controlleren starter op"/>
                     <event id="_0x8317c8" name="System tid -&gt; %P" icon="_0xc" note="Starter program når systemtiden rammer %P" link1="_0x83120d" method="_0xa"/>
                  </events>
