               <resource_output id="_0x198412" name="Udgang for Ur" icon="_0x39" note="Anvendes til urstyring"/>
               <resource_output id="_0x198512" name="Udgang for ON puls" icon="_0x39" note="Anvendes ifm sluk eller tænd indgange på andre funktionsblokke samt til styring af dimmere"/>
               <resource_output id="_0x198612" name="Udgang for OFF puls" icon="_0x39" note="Anvendes ifm sluk eller tænd indgange på andre funktionsblokke samt til styring af dimmere">
