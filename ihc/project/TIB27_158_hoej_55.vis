               <resource_time id="_0x22d60d" name="Tidspunkt_Offset_Solopgang" icon="_0x2f" note="Hvis sol står op 07:35 og man først ønsker udgangen skal gå on en time senere, skal denne offset sættes til 01:00:00, hvis man i stedet ønsker udgangen skal gå on en time tidligere, skal denne offset sættes til 23:00:00" hour="0" minute="0" second="0"/>
               <resource_time id="_0x22d70d" name="Tidspunkt_Offset_Solnedgang" icon="_0x2f" note="Hvis sol går ned 17:35 og man først ønsker udgangen skal gå on en time senere, skal denne offset sættes til 01:00:00, hvis man i stedet ønsker udgangen skal gå on en time tidligere, skal denne offset sættes til 23:00:00" hour="0" minute="0" second="0"/>
